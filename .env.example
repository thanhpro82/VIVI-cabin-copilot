# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
# CHỈ scheme `sqlite:///` — `src/db.py::resolve_db_path` raise với mọi scheme khác.
# Dòng `postgresql://...` của boilerplate trước đây là sai và sẽ làm backend chết lúc
# khởi động kể từ #46, khi users/sessions/approvals/idempotency thật sự đọc biến này.
DATABASE_URL=sqlite:///./data/app.db
# `sqlite:///:memory:` cho DB sạch trong RAM — `tests/conftest.py` dùng đúng giá trị này.

# Số vòng PBKDF2 cho mật khẩu (`users.password_hash`). Đừng hạ ở môi trường thật;
# bộ test tự hạ để không trả ~9 s chỉ cho việc băm.
# AUTH_PBKDF2_ITERATIONS=200000

# ---- RAG / Vector Store ----
# ADR-003 chốt FAISS + SQLite embedded, KHÔNG dùng Chroma.
# Artifact do `python -m src.rag.cli ingest` sinh ra.
RAG_INDEX_DIR=./data/rag/vf9_2026_vi
# Hai ngưỡng của grader lai, hiệu chỉnh bằng `python -m src.rag.cli calibrate`.
RAG_MIN_SCORE=0.848
RAG_MIN_OVERLAP=0.65

# ---- MQTT / Xe ảo ----
# ADR-004 + docs/mqtt_spec.md. Topic: v1/vehicles/{VEHICLE_ID}/...
# Đặt MQTT_ENABLED=false để chạy backend không cần broker (test, CI).
MQTT_ENABLED=true
MQTT_URL=mqtt://localhost:1883
VEHICLE_ID=vehicle-demo-01

# Cổng loopback phía host cho broker. Chỉ đổi khi máy đã có broker khác giữ
# 1883 (RabbitMQ với plugin MQTT, EMQX, ...) — khi đó đặt cả hai:
#   MQTT_HOST_PORT=1884
#   MQTT_URL=mqtt://localhost:1884
# Trong docker network các service vẫn luôn nối tới mqtt:1883.
MQTT_HOST_PORT=1883

# Hai identity tách biệt, sinh bằng scripts/bootstrap_mqtt_secrets.ps1.
# Production dùng *_PASSWORD_FILE (mount /run/secrets/...) theo docs/devops.md;
# biến trực tiếp chỉ để chạy local cho nhanh.
MQTT_BACKEND_USERNAME=vivi-backend
MQTT_BACKEND_PASSWORD=
MQTT_SIMULATOR_USERNAME=vehicle-simulator
MQTT_SIMULATOR_PASSWORD=

# Executor chờ CommandEvent bao lâu trước khi coi là lỗi transport
# (được retry đúng một lần với cùng command_id).
MQTT_COMMAND_TIMEOUT_MS=3000
# Heartbeat 5s; quá 15s (lỡ 3 nhịp) thì vehicle_simulator = down.
MQTT_HEARTBEAT_INTERVAL_S=5
MQTT_HEARTBEAT_STALE_S=15

# ---- Kênh harness v1/sim/ (ADR-024) — NGOÀI hợp đồng xe ----
# Cho phép đặt tốc độ/số của XE ẢO từ ngoài tiến trình, để dựng kịch bản nghiệm
# thu số 4 (chặn S3 khi xe đang chạy) mà không cần gõ vào stdin của xe ảo.
#
# Mặc định TẮT, và tắt nghĩa là không tồn tại: route POST /api/v1/sim/motion trả
# 404, xe ảo không subscribe. Bật thì phải đặt cho CẢ HAI service — backend và
# vehicle-simulator — nếu không, message gửi đi mà không ai nghe.
#
# Cảnh báo cho bản deploy công khai: xe ảo là tài nguyên DÙNG CHUNG, không có
# multi-tenant. Người khác kéo tốc độ sẽ đổi state giữa lượt của bạn.
SIM_CONTROL_ENABLED=false

# Chu kỳ tự chạy: xe tự lặp 0 km/h <-> SIM_DRIVE_CYCLE_SPEED_KPH, mỗi pha
# SIM_DRIVE_CYCLE_PHASE_S giây. Độc lập với cờ trên — không ai điều khiển được
# nó, nên đây là nửa an toàn hơn để bật một mình.
SIM_DRIVE_CYCLE=false
SIM_DRIVE_CYCLE_SPEED_KPH=45
SIM_DRIVE_CYCLE_PHASE_S=30

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

